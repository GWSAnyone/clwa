{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "declaration": true,
    "paths": {
      "@clwa/engine": ["./packages/engine/src/index.ts"],
      "@clwa/modules": ["./packages/modules/src/index.ts"],
      "@clwa/server": ["./packages/server/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
